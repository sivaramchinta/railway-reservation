{
  "name": "railway-reservation",
  "private": true,
  "description": "Mini railway reservation system: one train, one journey date, two classes.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev -w @railway/api\" \"npm run dev -w @railway/web\"",
    "lint": "eslint .",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:coverage": "npm run test:coverage -w @railway/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.18": true,
    "@parcel/watcher": false
  }
}
